# 공유 문구에 들어갈 서비스 URL (없으면 접속 중인 도메인 사용)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 이벤트 로깅 (SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY 둘 중 하나라도 없으면 로깅은 no-op)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# npm run verify:supabase 의 RLS(비인가 접근 차단) 검증에만 쓴다. 없어도 되고, 있으면 더 확인해준다
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 광고 (선택, 기본 OFF). NEXT_PUBLIC_ADS_ENABLED=true 로 켤 때만 아래 3개도 채운다
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_START=
NEXT_PUBLIC_AD_SLOT_RESULT=
